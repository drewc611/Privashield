# PrivaShield local development defaults. Change credentials before non-development use.
PRIVASHIELD_ENVIRONMENT=development
PRIVASHIELD_LOG_LEVEL=INFO
PRIVASHIELD_ENFORCEMENT_MODE=observe
PRIVASHIELD_DASHBOARD_PORT=8080

# Local AI is opt-in because the model download can be several GB.
PRIVASHIELD_OLLAMA_ENABLED=false
PRIVASHIELD_OLLAMA_MODEL=gemma3

# Linux host sensor profiles are opt-in. Set this to a capture interface before use.
PRIVASHIELD_NETWORK_INTERFACE=eth0
# PRIVASHIELD_MONITOR_PATH=/absolute/path/to/monitor

POSTGRES_DB=privashield
POSTGRES_USER=privashield
POSTGRES_PASSWORD=change-me-before-production
