# PrivaShield local development defaults. Do not use these credentials in production.
PRIVASHIELD_ENVIRONMENT=development
PRIVASHIELD_LOG_LEVEL=INFO
PRIVASHIELD_DATABASE_ENABLED=true
PRIVASHIELD_DATABASE_URL=postgresql+asyncpg://privashield:privashield@postgres:5432/privashield
PRIVASHIELD_ENFORCEMENT_MODE=observe

POSTGRES_DB=privashield
POSTGRES_USER=privashield
POSTGRES_PASSWORD=privashield
